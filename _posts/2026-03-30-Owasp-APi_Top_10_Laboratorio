{% raw %}
<style>

*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
:root{
  --bg:#080808;--bg2:#0e0e0e;--bg3:#161616;--bg4:#222;--bg5:#2a2a2a;
  --red:#ff1a1a;--red2:#cc0000;--red3:#ff4444;--red-dim:#551111;--red-glow:0 0 15px rgba(255,26,26,.5);
  --green:#00ff41;--green2:#00cc33;--green-dim:rgba(0,255,65,.1);
  --cyan:#00e5ff;--yellow:#ffd000;--orange:#ff6b00;--purple:#bb86fc;
  --text:#d4d4d4;--text-dim:#777;--text-dark:#444;
  --mono:'Fira Code',monospace;--head:'Orbitron',sans-serif;--body:'Chakra Petch',sans-serif;
}
html{scroll-behavior:smooth;font-size:15px}
body{background:var(--bg);color:var(--text);font-family:var(--body);overflow-x:hidden}
::selection{background:var(--red);color:#000}
::-webkit-scrollbar{width:6px}
::-webkit-scrollbar-track{background:var(--bg)}
::-webkit-scrollbar-thumb{background:var(--red-dim);border-radius:3px}

/* NAV */
nav{position:sticky;top:0;left:0;right:0;z-index:100;background:rgba(8,8,8,.95);backdrop-filter:blur(16px);border-bottom:1px solid var(--red-dim);padding:0 20px}
.nav-inner{max-width:1300px;margin:0 auto;display:flex;align-items:center;gap:12px;height:50px;overflow-x:auto}
.nav-logo{font-family:var(--head);font-size:.7rem;color:var(--red);white-space:nowrap;letter-spacing:2px;text-shadow:var(--red-glow)}
.nav-sep{color:var(--text-dark);font-size:.7rem}
.nav-btn{
  background:none;border:1px solid transparent;color:var(--text-dim);font-family:var(--mono);font-size:.65rem;
  padding:5px 10px;border-radius:3px;cursor:pointer;white-space:nowrap;transition:all .2s;
}
.nav-btn:hover,.nav-btn.active{color:var(--red);border-color:var(--red-dim);background:rgba(255,26,26,.05)}

/* PROGRESS */
#prog{position:fixed;top:0;left:0;height:2px;background:linear-gradient(90deg,var(--red),var(--orange));z-index:1000;width:0;transition:width .15s}

/* SECTIONS */
.lab-section{padding:80px 20px 60px;max-width:1200px;margin:0 auto;min-height:100vh}
.lab-section:first-of-type{padding-top:90px}
.lab-header{display:flex;align-items:center;gap:16px;margin-bottom:10px;flex-wrap:wrap}
.lab-num{font-family:var(--head);font-size:2.8rem;font-weight:900;color:var(--red);text-shadow:0 0 30px rgba(255,26,26,.3);line-height:1}
.lab-title{font-family:var(--head);font-size:clamp(.9rem,2.5vw,1.4rem);font-weight:700;color:var(--text);letter-spacing:.5px}
.lab-id{font-family:var(--mono);font-size:.7rem;color:var(--red);background:rgba(255,26,26,.1);padding:2px 8px;border-radius:3px;display:inline-block;margin-top:4px}
.lab-desc{font-size:.85rem;color:var(--text-dim);max-width:750px;margin:12px 0 24px;line-height:1.7}

/* INTERACTIVE CONTAINER */
.sim-box{
  background:var(--bg2);border:1px solid var(--bg4);border-radius:8px;
  overflow:hidden;margin:20px 0;
}
.sim-toolbar{
  display:flex;align-items:center;gap:8px;padding:10px 16px;
  background:var(--bg3);border-bottom:1px solid var(--bg4);
}
.sim-dot{width:10px;height:10px;border-radius:50%}
.sim-dot.r{background:#ff5f57}.sim-dot.y{background:#ffbd2e}.sim-dot.g{background:#28c840}
.sim-label{font-family:var(--mono);font-size:.65rem;color:var(--text-dim);margin-left:auto}
.sim-body{padding:24px;position:relative}

/* FLOW DIAGRAM SVG CONTAINER */
.flow-container{
  width:100%;overflow-x:auto;padding:20px 0;
}
.flow-visual{
  display:flex;align-items:center;gap:0;min-width:max-content;padding:10px 0;
}
.flow-node{
  display:flex;flex-direction:column;align-items:center;gap:8px;
  min-width:120px;max-width:140px;cursor:pointer;transition:all .3s;position:relative;
}
.flow-node:hover{transform:translateY(-4px)}
.flow-node.active .node-circle{background:var(--red);box-shadow:var(--red-glow);color:#000}
.flow-node.done .node-circle{background:var(--green);box-shadow:0 0 15px rgba(0,255,65,.4);color:#000}
.node-circle{
  width:48px;height:48px;border-radius:50%;border:2px solid var(--red-dim);
  background:var(--bg);display:flex;align-items:center;justify-content:center;
  font-family:var(--head);font-weight:900;font-size:.9rem;color:var(--red);
  transition:all .4s;position:relative;z-index:2;
}
.node-label{font-family:var(--mono);font-size:.6rem;color:var(--text-dim);text-align:center;line-height:1.3;max-width:130px}
.flow-arrow{
  width:50px;height:2px;background:var(--red-dim);position:relative;flex-shrink:0;
  display:flex;align-items:center;justify-content:flex-end;
}
.flow-arrow::after{content:'▶';color:var(--red-dim);font-size:.6rem;position:absolute;right:-2px}
.flow-arrow.lit{background:var(--red);animation:arrowPulse 1s}
.flow-arrow.lit::after{color:var(--red)}
@keyframes arrowPulse{0%{opacity:.3}100%{opacity:1}}

/* TERMINAL OUTPUT */
.terminal{
  background:#050505;border:1px solid var(--bg4);border-radius:6px;
  padding:16px;font-family:var(--mono);font-size:.72rem;line-height:1.8;
  max-height:350px;overflow-y:auto;margin:12px 0;white-space:pre-wrap;word-break:break-all;
}
.t-red{color:var(--red)}.t-green{color:var(--green)}.t-cyan{color:var(--cyan)}
.t-yellow{color:var(--yellow)}.t-dim{color:var(--text-dim)}.t-orange{color:var(--orange)}
.t-purple{color:var(--purple)}.t-white{color:#fff;font-weight:600}

/* BUTTONS */
.btn{
  font-family:var(--mono);font-size:.72rem;padding:8px 18px;border-radius:4px;
  cursor:pointer;transition:all .2s;border:1px solid;display:inline-flex;align-items:center;gap:6px;
}
.btn-red{background:rgba(255,26,26,.1);border-color:var(--red-dim);color:var(--red)}
.btn-red:hover{background:var(--red);color:#000;box-shadow:var(--red-glow)}
.btn-green{background:rgba(0,255,65,.05);border-color:rgba(0,255,65,.3);color:var(--green)}
.btn-green:hover{background:var(--green);color:#000}
.btn-cyan{background:rgba(0,229,255,.05);border-color:rgba(0,229,255,.3);color:var(--cyan)}
.btn-cyan:hover{background:var(--cyan);color:#000}
.btn-sm{padding:5px 12px;font-size:.65rem}
.btn:disabled{opacity:.3;cursor:not-allowed;pointer-events:none}

/* GRID */
.sim-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
@media(max-width:800px){.sim-grid{grid-template-columns:1fr}}

/* INPUT */
.sim-input{
  background:var(--bg);border:1px solid var(--bg4);border-radius:4px;
  color:var(--text);font-family:var(--mono);font-size:.75rem;
  padding:8px 12px;width:100%;outline:none;transition:border-color .2s;
}
.sim-input:focus{border-color:var(--red)}
.sim-input::placeholder{color:var(--text-dark)}

/* ENTITY BOXES */
.entity{
  border:1px solid var(--bg4);border-radius:8px;padding:16px;background:var(--bg);
  text-align:center;transition:all .4s;position:relative;
}
.entity.highlight{border-color:var(--red);box-shadow:0 0 20px rgba(255,26,26,.2)}
.entity.success{border-color:var(--green);box-shadow:0 0 20px rgba(0,255,65,.2)}
.entity.warn{border-color:var(--yellow);box-shadow:0 0 20px rgba(255,208,0,.2)}
.entity-icon{font-size:2rem;margin-bottom:8px;display:block}
.entity-name{font-family:var(--head);font-size:.7rem;color:var(--text);letter-spacing:1px}
.entity-sub{font-family:var(--mono);font-size:.6rem;color:var(--text-dim);margin-top:4px}

/* PACKET ANIMATION */
@keyframes packetMove{
  0%{transform:translateX(0);opacity:0}
  10%{opacity:1}
  90%{opacity:1}
  100%{transform:translateX(var(--dist));opacity:0}
}
.packet{
  position:absolute;width:12px;height:12px;border-radius:2px;
  background:var(--red);box-shadow:var(--red-glow);z-index:10;
}
.packet.good{background:var(--green);box-shadow:0 0 10px rgba(0,255,65,.5)}

/* STATUS BADGE */
.status{
  display:inline-flex;align-items:center;gap:4px;
  font-family:var(--mono);font-size:.65rem;padding:3px 10px;border-radius:12px;
}
.status-ok{background:rgba(0,255,65,.1);color:var(--green);border:1px solid rgba(0,255,65,.2)}
.status-fail{background:rgba(255,26,26,.1);color:var(--red);border:1px solid rgba(255,26,26,.2)}
.status-warn{background:rgba(255,208,0,.1);color:var(--yellow);border:1px solid rgba(255,208,0,.2)}

/* VISUAL DIAGRAM AREAS */
.diagram-area{
  background:var(--bg);border:1px solid var(--bg4);border-radius:8px;
  padding:20px;min-height:200px;position:relative;overflow:hidden;
}
.diagram-title{font-family:var(--head);font-size:.65rem;color:var(--red);letter-spacing:2px;margin-bottom:16px;text-transform:uppercase}

/* SERVER/CLIENT BOXES */
.arch-box{
  display:inline-flex;flex-direction:column;align-items:center;gap:4px;
  padding:12px 16px;border:1px solid var(--bg4);border-radius:6px;
  background:var(--bg2);transition:all .4s;min-width:100px;
}
.arch-box .icon{font-size:1.5rem}
.arch-box .label{font-family:var(--mono);font-size:.6rem;color:var(--text-dim)}
.arch-box.attacked{border-color:var(--red);background:rgba(255,26,26,.08)}
.arch-box.compromised{border-color:var(--red);background:rgba(255,26,26,.15);animation:pulse-border 1s infinite}
@keyframes pulse-border{0%,100%{box-shadow:none}50%{box-shadow:0 0 15px rgba(255,26,26,.3)}}

/* JWT Visualization */
.jwt-part{
  display:inline-block;padding:4px 8px;border-radius:3px;font-family:var(--mono);
  font-size:.65rem;word-break:break-all;margin:2px;cursor:pointer;transition:all .2s;
}
.jwt-header{background:rgba(255,26,26,.15);color:var(--red);border:1px solid var(--red-dim)}
.jwt-payload{background:rgba(187,134,252,.15);color:var(--purple);border:1px solid rgba(187,134,252,.3)}
.jwt-sig{background:rgba(0,229,255,.15);color:var(--cyan);border:1px solid rgba(0,229,255,.3)}

/* METER */
.meter-row{display:flex;align-items:center;gap:10px;margin:8px 0}
.meter-label{font-family:var(--mono);font-size:.6rem;color:var(--text-dim);min-width:50px}
.meter-bar{flex:1;height:10px;background:var(--bg);border-radius:5px;overflow:hidden;border:1px solid var(--bg4)}
.meter-fill{height:100%;border-radius:5px;transition:width .5s ease}
.meter-fill.red{background:linear-gradient(90deg,var(--red2),var(--red))}
.meter-fill.green{background:linear-gradient(90deg,var(--green2),var(--green))}

/* SEPARATOR */
.section-sep{width:100%;height:1px;background:linear-gradient(90deg,transparent,var(--red-dim),transparent);margin:0}

/* HERO */
.hero{text-align:center;padding:100px 20px 40px}
.hero h1{font-family:var(--head);font-size:clamp(1.6rem,5vw,3.5rem);font-weight:900;color:var(--red);text-shadow:0 0 40px rgba(255,26,26,.25)}
.hero h1 span{color:var(--text)}
.hero-sub{font-size:1rem;color:var(--text-dim);margin-top:12px;font-weight:300}
.hero-tag{font-family:var(--mono);font-size:.7rem;color:var(--red);border:1px solid var(--red-dim);display:inline-block;padding:4px 14px;border-radius:20px;margin-bottom:16px;letter-spacing:2px}

/* RESPONSIVE */
@media(max-width:700px){
  .flow-visual{transform:scale(.85);transform-origin:left center}
  .sim-grid{grid-template-columns:1fr}
  .lab-num{font-size:2rem}
}

/* FOOTER */
footer{text-align:center;padding:40px 20px;border-top:1px solid var(--bg3)}
footer p{font-family:var(--mono);font-size:.65rem;color:var(--text-dark)}
</style>

