<!-- ======================= LAB 01: BOLA ======================= -->
<div class="section-sep"></div>
<section class="lab-section" id="s1">
  <div class="lab-header">
    <div class="lab-num">01</div>
    <div><div class="lab-title">Broken Object Level Authorization</div><span class="lab-id">API1:2023 — BOLA</span></div>
  </div>
  <p class="lab-desc">Escenario: Un e-commerce expone un endpoint <code style="color:var(--red)">/api/users/{id}/orders</code>. El atacante está autenticado como User 101, pero cambia el ID para acceder a datos de otros usuarios. Haga clic en "Ejecutar Ataque" para simular la explotación paso a paso.</p>

  <div class="sim-box">
    <div class="sim-toolbar">
      <span class="sim-dot r"></span><span class="sim-dot y"></span><span class="sim-dot g"></span>
      <span class="sim-label">SIMULACIÓN BOLA — IDOR Attack</span>
    </div>
    <div class="sim-body">
      <!-- Architecture diagram -->
      <div style="display:flex;align-items:center;justify-content:center;gap:30px;flex-wrap:wrap;margin-bottom:20px" id="bola-arch">
        <div class="arch-box" id="bola-attacker">
          <span class="icon">🔓</span>
          <span class="label">ATACANTE</span>
          <span style="font-family:var(--mono);font-size:.55rem;color:var(--yellow)">User ID: 101</span>
        </div>
        <div style="display:flex;flex-direction:column;align-items:center;gap:4px" id="bola-req-area">
          <div style="font-family:var(--mono);font-size:.55rem;color:var(--text-dark)" id="bola-req-text">— petición →</div>
          <div style="width:100px;height:2px;background:var(--bg4);position:relative" id="bola-line1"></div>
        </div>
        <div class="arch-box" id="bola-api">
          <span class="icon">⚙️</span>
          <span class="label">API SERVER</span>
          <span style="font-family:var(--mono);font-size:.55rem;color:var(--text-dark)">/api/users/{id}/orders</span>
        </div>
        <div style="display:flex;flex-direction:column;align-items:center;gap:4px">
          <div style="font-family:var(--mono);font-size:.55rem;color:var(--text-dark)">— query →</div>
          <div style="width:80px;height:2px;background:var(--bg4)"></div>
        </div>
        <div class="arch-box" id="bola-db">
          <span class="icon">🗄️</span>
          <span class="label">DATABASE</span>
          <span style="font-family:var(--mono);font-size:.55rem;color:var(--text-dark)">users & orders</span>
        </div>
      </div>

      <!-- Interactive flow -->
      <div class="flow-container">
        <div class="flow-visual" id="bola-flow">
          <div class="flow-node" id="bola-s1"><div class="node-circle">1</div><div class="node-label">Login legítimo como User 101</div></div>
          <div class="flow-arrow" id="bola-a1"></div>
          <div class="flow-node" id="bola-s2"><div class="node-circle">2</div><div class="node-label">GET /api/users/101/orders (datos propios)</div></div>
          <div class="flow-arrow" id="bola-a2"></div>
          <div class="flow-node" id="bola-s3"><div class="node-circle">3</div><div class="node-label">Modificar ID: /users/102/orders</div></div>
          <div class="flow-arrow" id="bola-a3"></div>
          <div class="flow-node" id="bola-s4"><div class="node-circle">4</div><div class="node-label">API NO valida ownership del recurso</div></div>
          <div class="flow-arrow" id="bola-a4"></div>
          <div class="flow-node" id="bola-s5"><div class="node-circle">5</div><div class="node-label">200 OK — Datos de víctima expuestos</div></div>
          <div class="flow-arrow" id="bola-a5"></div>
          <div class="flow-node" id="bola-s6"><div class="node-circle">6</div><div class="node-label">Script enumera IDs 102→999 masivamente</div></div>
        </div>
      </div>

      <div class="sim-grid">
        <div>
          <div style="margin-bottom:8px;font-family:var(--mono);font-size:.65rem;color:var(--text-dim)">▸ ID de usuario a consultar:</div>
          <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px">
            <button class="btn btn-green btn-sm" onclick="bolaQuery(101)">ID: 101 (propio)</button>
            <button class="btn btn-red btn-sm" onclick="bolaQuery(102)">ID: 102 (víctima)</button>
            <button class="btn btn-red btn-sm" onclick="bolaQuery(103)">ID: 103 (víctima)</button>
            <button class="btn btn-cyan btn-sm" onclick="bolaRunAll()">⚡ Enumerar 101→110</button>
          </div>
          <button class="btn btn-red" id="bola-run-btn" onclick="bolaAnimate()">▶ Ejecutar Flujo de Ataque</button>
          <button class="btn btn-green btn-sm" style="margin-left:6px" onclick="bolaReset()">↺ Reset</button>
        </div>
        <div class="terminal" id="bola-term"><span class="t-dim">root@attacker:~$ </span><span class="t-green">Esperando acción del operador...</span>
</div>
      </div>
    </div>
  </div>
</section>

<!-- ======================= LAB 02: BROKEN AUTH ======================= -->
<div class="section-sep"></div>
<section class="lab-section" id="s2">
  <div class="lab-header">
    <div class="lab-num">02</div>
    <div><div class="lab-title">Broken Authentication</div><span class="lab-id">API2:2023 — JWT Attack</span></div>
  </div>
  <p class="lab-desc">Escenario: Una API usa JWT con verificación de firma defectuosa (acepta alg:none). El atacante decodifica su token, modifica el rol a "admin" y elimina la firma. Haga clic en cada paso para ver cómo se forja el token.</p>

  <div class="sim-box">
    <div class="sim-toolbar">
      <span class="sim-dot r"></span><span class="sim-dot y"></span><span class="sim-dot g"></span>
      <span class="sim-label">SIMULACIÓN JWT — Algorithm Confusion Attack</span>
    </div>
    <div class="sim-body">
      <div class="flow-container">
        <div class="flow-visual" id="jwt-flow">
          <div class="flow-node" id="jwt-s1"><div class="node-circle">1</div><div class="node-label">Capturar JWT del token propio</div></div>
          <div class="flow-arrow" id="jwt-a1"></div>
          <div class="flow-node" id="jwt-s2"><div class="node-circle">2</div><div class="node-label">Decodificar Base64 (header + payload)</div></div>
          <div class="flow-arrow" id="jwt-a2"></div>
          <div class="flow-node" id="jwt-s3"><div class="node-circle">3</div><div class="node-label">Cambiar alg:RS256 → alg:none</div></div>
          <div class="flow-arrow" id="jwt-a3"></div>
          <div class="flow-node" id="jwt-s4"><div class="node-circle">4</div><div class="node-label">Cambiar role:user → role:admin</div></div>
          <div class="flow-arrow" id="jwt-a4"></div>
          <div class="flow-node" id="jwt-s5"><div class="node-circle">5</div><div class="node-label">Re-encodar sin firma → Token forjado</div></div>
          <div class="flow-arrow" id="jwt-a5"></div>
          <div class="flow-node" id="jwt-s6"><div class="node-circle">6</div><div class="node-label">Enviar al server → Acceso admin</div></div>
        </div>
      </div>

      <!-- JWT Visual -->
      <div style="margin:16px 0;text-align:center">
        <div style="font-family:var(--mono);font-size:.6rem;color:var(--text-dim);margin-bottom:8px">TOKEN JWT ACTUAL:</div>
        <div id="jwt-display" style="word-break:break-all;max-width:100%;padding:12px;background:var(--bg);border:1px solid var(--bg4);border-radius:6px;text-align:left">
          <span class="jwt-header" id="jwt-h">eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9</span><span style="color:var(--text-dark)">.</span><span class="jwt-payload" id="jwt-p">eyJzdWIiOiJ1c2VyMTAxIiwicm9sZSI6InVzZXIiLCJpYXQiOjE3MDAwMDAwMDB9</span><span style="color:var(--text-dark)">.</span><span class="jwt-sig" id="jwt-s">SflKxwRJSMeKKF2QT4fw...</span>
        </div>
      </div>

      <div class="sim-grid">
        <div>
          <div id="jwt-decoded" style="background:var(--bg);border:1px solid var(--bg4);border-radius:6px;padding:12px;font-family:var(--mono);font-size:.68rem;line-height:1.8">
            <div style="color:var(--text-dim);margin-bottom:4px">▸ HEADER:</div>
