function bflaTest(method,path,result){
  const t='bfla-term';
  if(result==='allowed'){
    typeIn(t,`\n${method} ${path}`,'t-cyan');typeIn(t,'  → 200 OK [Acceso permitido — función pública ✔]','t-green');
  }else if(result==='blocked'){
    typeIn(t,`\n${method} ${path}`,'t-cyan');typeIn(t,'  → 403 Forbidden [Rol "user" bloqueado correctamente ✔]','t-green');
  }else{
    typeIn(t,`\n${method} ${path}`,'t-red');
    typeIn(t,`  → 200 OK [⚠ BFLA: Método ${method} NO VERIFICÓ EL ROL]`,'t-red');
    if(method==='DELETE')typeIn(t,'  ☠ Usuario 102 ELIMINADO por un usuario sin privilegios admin','t-orange');
    if(method==='PUT')typeIn(t,'  ☠ Usuario 102 MODIFICADO — role cambiado a "admin"','t-orange');
    if(method==='POST')typeIn(t,'  ☠ Nuevo usuario admin creado sin autorización','t-orange');
  }
}

