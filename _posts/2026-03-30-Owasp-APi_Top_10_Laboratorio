  const arrow=document.getElementById(`${prefix}-a${n-1}`);
  if(arrow)arrow.classList.add('lit');
}
function doneStep(prefix,n){
  const node=document.getElementById(`${prefix}-s${n}`);
  if(node){node.classList.remove('active');node.classList.add('done')}
}
function resetFlow(prefix,count){
  for(let i=1;i<=count;i++){
